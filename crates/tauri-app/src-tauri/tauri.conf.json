{
  "productName": "Sovereign Data Agent",
  "version": "0.1.14",
  "identifier": "ma.albaraa.sovereign-data-agent",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Sovereign Data Agent",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: ; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/sovereign-node-active",
      "binaries/sovereign-relay",
      "binaries/sovereign-supervisor"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/sovereign-node-active-x86_64-pc-windows-msvc.exe": "sovereign-node-active.exe",
      "binaries/sovereign-relay-x86_64-pc-windows-msvc.exe": "sovereign-relay.exe",
      "binaries/sovereign-supervisor-x86_64-pc-windows-msvc.exe": "sovereign-supervisor.exe",
      "../../../scripts/windows/03_setup_standby_win.ps1": "scripts/windows/03_setup_standby_win.ps1",
      "../../../scripts/windows/04_start_supervisor.ps1": "scripts/windows/04_start_supervisor.ps1"
    }
  }
}
