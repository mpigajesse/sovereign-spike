<mxfile host="app.diagrams.net" modified="2026-05-30" version="21.0.0">
  <diagram name="Flux de Données — Pipeline SDA" id="pipeline">
    <mxGraphModel dx="1400" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- FOND -->
        <mxCell id="bg" value="" style="rounded=0;fillColor=#0D0A07;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1400" height="600" as="geometry" />
        </mxCell>

        <!-- TITRE -->
        <mxCell id="title" value="Flux de Données SDA — De l&apos;Ingestion à la Réplication P2P" style="text;html=1;align=center;fontColor=#C79A1B;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="15" width="1200" height="35" as="geometry" />
        </mxCell>

        <!-- ═══ ÉTAPE 0 : APPLICATION ═══ -->
        <mxCell id="app" value="📱 Application&lt;br&gt;Client&lt;br&gt;&lt;br&gt;(n'importe quelle&lt;br&gt;application métier)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1208;strokeColor=#6366f1;strokeWidth=2;fontColor=#E6EDF3;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="150" height="130" as="geometry" />
        </mxCell>

        <!-- ═══ ÉTAPE 1 : API REST ═══ -->
        <mxCell id="api" value="⚡ FastAPI&lt;br&gt;Backend&lt;br&gt;&lt;br&gt;POST /api/v1/data/ingest&lt;br&gt;{tenant_id, data}&lt;br&gt;&lt;br&gt;Validation + SHA-256&lt;br&gt;Audit trail chaîné" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1208;strokeColor=#34D399;strokeWidth=2;fontColor=#E6EDF3;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="240" y="210" width="175" height="170" as="geometry" />
        </mxCell>

        <!-- ═══ ÉTAPE 2 : DUCKDB ═══ -->
        <mxCell id="duckdb" value="📊 DuckDB&lt;br&gt;OLAP Engine&lt;br&gt;&lt;br&gt;INSERT données&lt;br&gt;requêtes analytiques&lt;br&gt;&lt;br&gt;609 enreg. &lt; 1s&lt;br&gt;16 tenants distincts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1208;strokeColor=#34D399;strokeWidth=2;fontColor=#E6EDF3;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="465" y="210" width="175" height="170" as="geometry" />
        </mxCell>

        <!-- ═══ ÉTAPE 3 : PARQUET ═══ -->
        <mxCell id="parquet" value="📄 Export Parquet&lt;br&gt;Colonnaire&lt;br&gt;&lt;br&gt;Format Apache Parquet&lt;br&gt;Compressé + optimisé&lt;br&gt;&lt;br&gt;{tenant}_storage.parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1208;strokeColor=#C79A1B;strokeWidth=2;fontColor=#E6EDF3;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="690" y="210" width="175" height="170" as="geometry" />
        </mxCell>

        <!-- ═══ ÉTAPE 4 : FERNET CHIFFREMENT ═══ -->
        <mxCell id="fernet" value="🔐 Fernet&lt;br&gt;Chiffrement&lt;br&gt;&lt;br&gt;AES-128-CBC&lt;br&gt;+ HMAC-SHA256&lt;br&gt;&lt;br&gt;Clé PARQUET_FERNET_KEY&lt;br&gt;(.env — non versionné)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1208;strokeColor=#B3121B;strokeWidth=2;fontColor=#E6EDF3;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="915" y="210" width="175" height="170" as="geometry" />
        </mxCell>

        <!-- ═══ ÉTAPE 5 : SYNCTHING ═══ -->
        <mxCell id="sync" value="🔄 Syncthing&lt;br&gt;P2P (BEP)&lt;br&gt;&lt;br&gt;TLS 1.3 inter-nœuds&lt;br&gt;mDNS découverte auto&lt;br&gt;&lt;br&gt;Réplication → 3 nœuds&lt;br&gt;~15 secondes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C1208;strokeColor=#C79A1B;strokeWidth=2;fontColor=#E6EDF3;fontSize=12;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="210" width="175" height="170" as="geometry" />
        </mxCell>

        <!-- ═══ FLÈCHES PIPELINE ═══ -->
        <mxCell id="a1" value="HTTPS :443&lt;br&gt;mTLS" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#34D399;strokeWidth=3;fontColor=#34D399;fontSize=11;labelBackgroundColor=#0D0A07;endArrow=block;endFill=1;" edge="1" source="app" target="api" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="a2" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#34D399;strokeWidth=3;fontColor=#34D399;fontSize=11;labelBackgroundColor=#0D0A07;endArrow=block;endFill=1;" edge="1" source="api" target="duckdb" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="a3" value="EXPORT" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#C79A1B;strokeWidth=3;fontColor=#C79A1B;fontSize=11;labelBackgroundColor=#0D0A07;endArrow=block;endFill=1;" edge="1" source="duckdb" target="parquet" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="a4" value="ENCRYPT" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#B3121B;strokeWidth=3;fontColor=#B3121B;fontSize=11;labelBackgroundColor=#0D0A07;endArrow=block;endFill=1;" edge="1" source="parquet" target="fernet" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="a5" value="P2P SYNC" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#C79A1B;strokeWidth=3;fontColor=#C79A1B;fontSize=11;labelBackgroundColor=#0D0A07;endArrow=block;endFill=1;" edge="1" source="fernet" target="sync" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══ SQLITE AUDIT TRAIL ═══ -->
        <mxCell id="sqlite" value="🗄️ SQLite — Audit Trail SHA-256&lt;br&gt;&lt;br&gt;record_hash = SHA256(données + previous_hash)&lt;br&gt;Chaîne non falsifiable — blockchain-style" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#090705;strokeColor=#3D2A1E;strokeWidth=2;fontColor=#8B8B8B;fontSize=12;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="240" y="430" width="400" height="70" as="geometry" />
        </mxCell>

        <mxCell id="as" value="HASH chaîné" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3D2A1E;strokeWidth=2;fontColor=#8B8B8B;fontSize=11;labelBackgroundColor=#0D0A07;dashed=1;endArrow=open;" edge="1" source="api" target="sqlite" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ═══ NŒUD PAIR ═══ -->
        <mxCell id="peer" value="🖥️ Nœud Ubuntu / Kali&lt;br&gt;&lt;br&gt;Réceptionne le Parquet.enc&lt;br&gt;DuckDB déchiffre + requête&lt;br&gt;Données de Win11 visibles localement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#090705;strokeColor=#34D399;strokeWidth=2;fontColor=#34D399;fontSize=12;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="940" y="430" width="375" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ap" value="~15s" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#34D399;strokeWidth=2;fontColor=#34D399;fontSize=11;labelBackgroundColor=#0D0A07;endArrow=block;endFill=1;" edge="1" source="sync" target="peer" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

