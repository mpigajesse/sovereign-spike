<mxfile host="app.diagrams.net" modified="2026-05-30" version="21.0.0">
  <diagram name="Sécurité Multicouche SDA" id="security">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1200" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- FOND -->
        <mxCell id="bg" value="" style="rounded=0;fillColor=#0D0A07;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1200" height="800" as="geometry" />
        </mxCell>

        <!-- TITRE -->
        <mxCell id="title" value="Architecture de Sécurité SDA — Défense en Profondeur" style="text;html=1;align=center;fontColor=#C79A1B;fontSize=18;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="20" width="1000" height="35" as="geometry" />
        </mxCell>

        <!-- ═══ COUCHE 1 : TRANSIT EXTERNE ═══ -->
        <mxCell id="c1-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2A0A0A;strokeColor=#B3121B;strokeWidth=3;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="80" y="80" width="1040" height="130" as="geometry" />
        </mxCell>
        <mxCell id="c1-label" value="🌐 COUCHE 1 — TRANSIT EXTERNE (Navigateur → nginx)" style="text;html=1;align=left;fontColor=#B3121B;fontSize=14;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="90" width="600" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c1-detail" value="• TLS 1.3 EXCLUSIF — TLS 1.2 rejeté (handshake failure)&lt;br&gt;• mTLS x509 — certificat client OBLIGATOIRE (HTTP 400 sans cert)&lt;br&gt;• CA interne SDA — PKI gérée localement (ca.crt · server.crt · client.crt)" style="text;html=1;align=left;fontColor=#E6EDF3;fontSize=13;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="118" width="800" height="80" as="geometry" />
        </mxCell>
        <mxCell id="c1-check" value="✅ Validé&lt;br&gt;3 nœuds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1C4A1C;strokeColor=#34D399;strokeWidth=2;fontColor=#34D399;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1000" y="115" width="100" height="70" as="geometry" />
        </mxCell>

        <!-- ═══ COUCHE 2 : TRANSIT INTER-NOEUDS ═══ -->
        <mxCell id="c2-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A1A0A;strokeColor=#C79A1B;strokeWidth=3;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="120" y="230" width="960" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c2-label" value="🔄 COUCHE 2 — TRANSIT INTER-NŒUDS (Syncthing P2P)" style="text;html=1;align=left;fontColor=#C79A1B;fontSize=14;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="140" y="240" width="600" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c2-detail" value="• BEP (Block Exchange Protocol) + TLS 1.3 inter-nœuds&lt;br&gt;• Authentification par Device ID cryptographique (unique par nœud)&lt;br&gt;• Seuls les nœuds explicitement ajoutés dans la config Syncthing peuvent se connecter" style="text;html=1;align=left;fontColor=#E6EDF3;fontSize=13;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="140" y="268" width="800" height="70" as="geometry" />
        </mxCell>

        <!-- ═══ COUCHE 3 : AT-REST PARQUET ═══ -->
        <mxCell id="c3-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0A1A0A;strokeColor=#34D399;strokeWidth=3;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="160" y="370" width="880" height="120" as="geometry" />
        </mxCell>
        <mxCell id="c3-label" value="💾 COUCHE 3 — AT-REST FICHIERS PARQUET (Fernet)" style="text;html=1;align=left;fontColor=#34D399;fontSize=14;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="180" y="380" width="600" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c3-detail" value="• Fernet = AES-128-CBC + HMAC-SHA256&lt;br&gt;• Clé PARQUET_FERNET_KEY partagée entre nœuds autorisés via .env (non versionné)&lt;br&gt;• Fichier illisible sans la clé — même si le disque est volé" style="text;html=1;align=left;fontColor=#E6EDF3;fontSize=13;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="180" y="408" width="800" height="70" as="geometry" />
        </mxCell>

        <!-- ═══ COUCHE 4 : AT-REST SQLITE ═══ -->
        <mxCell id="c4-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0A0A1A;strokeColor=#6366f1;strokeWidth=3;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="200" y="510" width="800" height="110" as="geometry" />
        </mxCell>
        <mxCell id="c4-label" value="🗄️ COUCHE 4 — AT-REST BASE SQLITE (SQLCipher)" style="text;html=1;align=left;fontColor=#6366f1;fontSize=14;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="220" y="520" width="600" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c4-detail" value="• SQLCipher : AES-256 sur toute la base de données SQLite&lt;br&gt;• Clé DB_ENCRYPTION_KEY dans .env — changement de clé = recréation de la DB" style="text;html=1;align=left;fontColor=#E6EDF3;fontSize=13;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="220" y="548" width="750" height="60" as="geometry" />
        </mxCell>

        <!-- ═══ COUCHE 5 : TRACABILITÉ ═══ -->
        <mxCell id="c5-bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1A0A0A;strokeColor=#C79A1B;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="240" y="640" width="720" height="100" as="geometry" />
        </mxCell>
        <mxCell id="c5-label" value="📋 COUCHE 5 — TRAÇABILITÉ (Audit Trail SHA-256 Chaîné)" style="text;html=1;align=left;fontColor=#C79A1B;fontSize=14;fontStyle=1;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="260" y="650" width="600" height="25" as="geometry" />
        </mxCell>
        <mxCell id="c5-detail" value="• record_hash = SHA256(données + previous_hash) — non falsifiable&lt;br&gt;• Toute modification d'un enregistrement rompt la chaîne — détection immédiate" style="text;html=1;align=left;fontColor=#E6EDF3;fontSize=13;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="260" y="678" width="680" height="50" as="geometry" />
        </mxCell>

        <!-- ═══ PRINCIPE CLEF ═══ -->
        <mxCell id="principle" value="Principe : Sécurité par Design — il est impossible de contourner structurellement ces protections." style="text;html=1;align=center;fontColor=#C79A1B;fontSize=13;fontStyle=2;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="100" y="758" width="1000" height="25" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
