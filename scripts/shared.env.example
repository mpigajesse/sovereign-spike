# ============================================================
# sovereign-spike — Variables d'environnement partagées
# Banc d'essai Phase 0
# ============================================================
# 1. Copier ce fichier en "shared.env" sur chaque machine
# 2. Remplir SOVEREIGN_DEK_HEX après la première génération
#    (voir étape 2 du script Windows 02_start_active.ps1)
# ============================================================

# ── DEK partagée entre toutes les machines ───────────────────
# Générée une fois sur Windows au premier démarrage sans cette variable.
# Récupérer la valeur depuis les logs, puis la copier ici.
SOVEREIGN_DEK_HEX=REMPLACER_PAR_LA_DEK_HEX_64_CARACTERES

# ── Clé API du relais (active ↔ relay) ──────────────────────
RELAY_API_KEY=sovereign-spike-relay-key-2026

# ── Réseau (banc d'essai VMnet1) ─────────────────────────────
ACTIVE_NODE_URL=http://192.168.200.1:3000
RELAY_URL=http://192.168.200.128:4000
